# Copy to backend/.env to override defaults. Every value is optional.
# Use "production" to turn off the interactive API docs (/docs, /openapi.json).
DATALENS_APP_NAME=DataLens API
DATALENS_ENVIRONMENT=development
DATALENS_CORS_ORIGINS=["http://localhost:3000"]

# Defaults are inside backend/data/ (gitignored). Uncomment to change them.
# DATALENS_DATABASE_URL=sqlite:///C:/path/to/datalens.db
# DATALENS_UPLOAD_DIR=C:/path/to/uploads
# Upload limit in MB. Analysis loads each file into memory, so keep this modest.
# DATALENS_MAX_UPLOAD_SIZE_MB=50
